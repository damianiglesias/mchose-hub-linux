{
  "_comment": [
    "MCHOSE A7 V2 Pro — Protocolo L7/A7 verificado (alexfrih/mchose-linux, PROTOCOL.md 2026-08-28).",
    "El mismo VID 5253 y los mismos comandos funcionan en: L7, L7 Pro, L7 Ultra, M7, A7, A7 Pro, A7 Ultra, K7.",
    "Protocolo: feature reports 0x11 (20 B) y 0x12 (64 B); payload completo invertido ^ 0xFF (sin checksum).",
    "El byte 0 de la respuesta es el Report ID (sin invertir); byte 1 = cmd ^ 0xFF (echo de verificación).",
    "VID:PID: 5253:1020 = dongle 2.4G / 8K  |  3837:4018 = cable  (el driver los trata igual).",
    "Para añadir el Bluetooth: 'BT:1020' suele ser el mismo PID pero en bus 0005."
  ],
  "schema_version": 1,
  "device": {
    "id": "mchose-a7-v2-pro",
    "name": "MCHOSE A7 V2 Pro",
    "kind": "mouse",
    "enabled": true,
    "verified": true,
    "author": "alexfrih (protocolo) + mchose-linux-hub (perfil)",
    "notes": "Verificado con L7 Pro 5253:1020, firmware 5.12.2.1. DPI/polling/LOD/sensor/debounce/sleep/RGB/batería."
  },
  "match": {
    "ids": [
      "5253:1020",
      "3837:4018"
    ],
    "_note_dongle2": "si tienes un dongle de 2000 Hz (3837:4018 con otro USB ID), añádelo aquí y en udev",
    "usage_page": "0xFF01",
    "usage": null,
    "interface_number": 2
  },
  "transport": {
    "_note": "Feature reports, sin checksum. Todo el payload (bytes 1 en adelante) va XOR 0xFF.",
    "write_mode": "output_report",
    "read_mode": "input_report",
    "report_id": "0x11",
    "report_length": 65,
    "response_timeout_ms": 3000,
    "retries": 8,
    "wake_delay_ms": 300,
    "inter_command_delay_ms": 25,
    "xor_mask": "0xFF"
  },
  "commands": {
    "get_battery": {
      "description": "Batería. write(0x12/0x06), leer por read() hasta rid=0x12.",
      "report_id": "0x12",
      "report_length": 65,
      "request": "06",
      "response": {
        "required": false,
        "expect": {
          "0": "0x12",
          "1": "0x06"
        },
        "fields": {
          "battery_percent": {
            "offset": 11,
            "type": "u8"
          },
          "charging": {
            "offset": 12,
            "type": "u8",
            "bool": true
          }
        }
      }
    },
    "get_rgb": {
