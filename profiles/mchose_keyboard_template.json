{
  "_comment": [
    "PLANTILLA DE TECLADO MCHOSE. Bytes ILUSTRATIVOS (inventados): sustitúyelos por los que captures (README §6).",
    "Muestra dos cosas que el ratón no usa: 'then' (enviar un comando de confirmación tras cada cambio, típico",
    "en teclados) y un comando sin control en la GUI (remap_key), que se prueba con la CLI:",
    "    mchose-hub send mchose-keyboard-template remap_key layer=0 key_index=14 keycode=0x0029",
    "IMPORTANTE: el teclado expone varias interfaces HID. Fija usage_page (o interface_number) a la de",
    "configuración; nunca a la interfaz con la que se escribe, que enviaría pulsaciones a tu sistema."
  ],

  "schema_version": 1,

  "device": {
    "id": "mchose-keyboard-template",
    "name": "MCHOSE Keyboard (plantilla)",
    "kind": "keyboard",
    "enabled": false,
    "verified": false,
    "author": "tu-usuario-de-github",
    "notes": "Plantilla. Cambia enabled a true cuando hayas verificado los payloads con tu hardware."
  },

  "match": {
    "vendor_id": "0x0000",
    "product_ids": ["0x0000"],
    "usage_page": "0xFF00",
    "usage": null,
    "interface_number": null
  },

  "transport": {
    "write_mode": "output_report",
    "read_mode": "input_report",
    "report_id": "0x00",
    "report_length": 65,
    "response_timeout_ms": 600,
    "retries": 3,
    "wake_delay_ms": 400,
    "inter_command_delay_ms": 10,
    "checksum": { "algorithm": "sum8", "init": "0x00", "start": 1, "end": 64, "store_at": 64 }
  },

  "commands": {
    "get_battery": {
      "description": "Batería (sólo en modo inalámbrico).",
      "request": "81",
      "response": {
        "expect": { "0": "0x81" },
        "fields": {
          "battery_percent": { "offset": 1, "type": "u8" },
          "charging": { "offset": 2, "type": "u8", "labels": { "0": "No", "1": "Sí" } }
        }
      }
    },

    "set_rgb": {
      "description": "Efecto, color, brillo y velocidad de la iluminación.",
      "request": "06 {effect} {color} {brightness} {speed}",
      "then": ["commit"],
      "params": {
        "effect": {
          "type": "u8", "default": 1,
          "choices": [
            { "label": "Apagado",       "value": 0, "wire": "0x00" },
            { "label": "Fijo",          "value": 1, "wire": "0x01" },
            { "label": "Respiración",   "value": 2, "wire": "0x02" },
            { "label": "Arcoíris",      "value": 3, "wire": "0x03" },
            { "label": "Reactivo",      "value": 4, "wire": "0x04" },
            { "label": "Onda",          "value": 5, "wire": "0x05" }
          ]
        },
        "color":      { "type": "rgb", "rgb_order": "grb", "default": "#ff3366" },
        "brightness": { "type": "u8", "min": 0, "max": 100, "step": 10, "default": 80, "unit": "%",
                        "linear": { "mul": 255, "div": 100, "add": 0 } },
        "speed":      { "type": "u8", "min": 1, "max": 4, "step": 1, "default": 2 }
      }
    },

    "remap_key": {
      "description": "Reasigna una tecla (índice físico) a un código HID de uso, en una capa.",
      "request": "08 {layer} {key_index} {keycode}",
      "then": ["commit"],
      "params": {
        "layer":     { "type": "u8", "min": 0, "max": 3, "default": 0 },
        "key_index": { "type": "u8", "min": 0, "max": 127 },
        "keycode":   { "type": "u16le", "min": 0, "max": 65535 }
      }
    },

    "commit": {
      "description": "Confirma y guarda en la memoria del teclado los cambios anteriores.",
      "request": "F0"
    }
  },

  "features": [
    { "id": "battery", "widget": "battery", "label": "Batería", "command": "get_battery",
      "percent": "battery_percent", "charging": "charging", "poll_seconds": 120 },

    { "id": "rgb_effect", "group": "Iluminación RGB", "label": "Efecto", "command": "set_rgb", "param": "effect" },
    { "id": "rgb_color", "group": "Iluminación RGB", "label": "Color", "command": "set_rgb", "param": "color" },
    { "id": "rgb_brightness", "group": "Iluminación RGB", "label": "Brillo", "command": "set_rgb", "param": "brightness" },
    { "id": "rgb_speed", "group": "Iluminación RGB", "label": "Velocidad", "command": "set_rgb", "param": "speed" }
  ]
}
